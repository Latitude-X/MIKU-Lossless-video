diff --git a/libavcodec/codec_desc.c b/libavcodec/codec_desc.c
index f5f2b17..fdb59b9 100644
--- a/libavcodec/codec_desc.c
+++ b/libavcodec/codec_desc.c
@@ -1992,6 +1992,31 @@ static const AVCodecDescriptor codec_descriptors[] = {
         .props     = AV_CODEC_PROP_LOSSY | AV_CODEC_PROP_LOSSLESS,
         .mime_types= MT("image/webp"),
     },
+    {
+        .id        = AV_CODEC_ID_MIKU_DELTA,
+        .type      = AVMEDIA_TYPE_VIDEO,
+        .name      = "miku_delta",
+        .long_name = NULL_IF_CONFIG_SMALL(".miku delta-frame residual"),
+        // Deliberately NOT AV_CODEC_PROP_INTRA_ONLY, unlike plain webp right
+        // above (matching webp_anim's own precedent immediately above this,
+        // for the same reason): a delta packet has a real, required
+        // dependency on the previously decoded frame. Getting this wrong
+        // would silently reintroduce, on this decoder's *output* frames,
+        // the same class of bug already found and fixed on the *encoder's*
+        // output packets (see mikuenc.c's capabilities comment and
+        // AV_PKT_DATA_MIKU_IS_DELTA's comment in packet.h) -- the generic
+        // decode pipeline forces AV_FRAME_FLAG_KEY onto every output frame
+        // for a codec whose descriptor claims AV_CODEC_PROP_INTRA_ONLY
+        // (libavcodec/decode.c, mirroring encode.c's mechanism), which
+        // would be actively wrong for delta frames.
+        //
+        // This entry's mere presence (regardless of props) is what's
+        // actually required, not just descriptive: verified via a real
+        // crash that ff_decode_preinit (libavcodec/decode.c) unconditionally
+        // dereferences avctx->codec_descriptor->props with no NULL check,
+        // which is NULL for any codec_id lacking an entry here at all.
+        .props     = AV_CODEC_PROP_LOSSLESS,
+    },
 
     /* various PCM "codecs" */
     {
diff --git a/libavcodec/codec_id.h b/libavcodec/codec_id.h
index 7cafac6..c637f6d 100644
--- a/libavcodec/codec_id.h
+++ b/libavcodec/codec_id.h
@@ -325,6 +325,28 @@ enum AVCodecID {
     AV_CODEC_ID_JPEGXS,
     AV_CODEC_ID_WEBP_ANIM,
 
+    // ---- .miku fork-local additions ----
+    // Value chosen explicitly (not auto-assigned) so it survives `git pull`
+    // merges against upstream FFmpeg without renumbering. Verified against a
+    // real clone of upstream FFmpeg: the last real assigned video ID above is
+    // AV_CODEC_ID_WEBP_ANIM, and the entire video ID range is one unbroken
+    // sequential block with no other explicit numeric assignment anywhere in
+    // it, all the way up to AV_CODEC_ID_FIRST_AUDIO (0x10000) -- so
+    // 0x112..0xFFFF (65,262 values) are genuinely free today. This is placed
+    // near the top of that range, far from where upstream sequentially
+    // appends new IDs (currently at 0x112), to stay safe across years of
+    // future upstream syncs. AVCodecID has no documented "private use" block
+    // of its own (unlike e.g. RIFF FourCCs or Matroska CodecID strings) --
+    // it's FFmpeg's own internal enum, not a wire format, so a fork-local
+    // unused value is the correct mechanism here, not a workaround.
+    //
+    // Reserve the top of the range downward for any future fork-local codec
+    // IDs so they stay grouped together rather than re-verified from scratch
+    // each time.
+    AV_CODEC_ID_MIKU_DELTA = 0xFFFE, ///< .miku delta-frame residual (opt-in -delta_frames).
+                                      ///< NOT standalone WebP bytes -- decoding requires
+                                      ///< ff_miku_delta_decoder, never the stock webp decoder.
+
     /* various PCM "codecs" */
     AV_CODEC_ID_FIRST_AUDIO = 0x10000,     ///< A dummy id pointing at the start of audio codecs
     AV_CODEC_ID_PCM_S16LE = 0x10000,
diff --git a/libavcodec/packet.h b/libavcodec/packet.h
index 00774a7..ba7ad67 100644
--- a/libavcodec/packet.h
+++ b/libavcodec/packet.h
@@ -383,6 +383,27 @@ enum AVPacketSideDataType {
      */
     AV_PKT_DATA_HEVC_CONF,
 
+    // ---- .miku fork-local addition ----
+    // Presence (any size, content unused) on a packet from the "miku"
+    // encoder means "this is a delta-chain frame, not a keyframe" -- see
+    // mikuenc.c and mikumux.c. Purely an in-process signal between this
+    // encoder and this muxer, never serialized to disk, so (unlike
+    // AV_CODEC_ID_MIKU_DELTA) it doesn't need an explicit,
+    // collision-resistant numeric value; a plain sequential entry is safe.
+    //
+    // Why this exists instead of AV_PKT_FLAG_KEY: verified directly against
+    // libavcodec/encode.c that AV_CODEC_ID_WEBP's codec descriptor has
+    // AV_CODEC_PROP_INTRA_ONLY set, which makes the generic encode pipeline
+    // force AV_PKT_FLAG_KEY onto every packet this encoder produces
+    // (avpkt->flags |= ec->intra_only_flag, applied *after* this encoder's
+    // own callback returns) -- decided from avctx->codec_id at
+    // ff_encode_preinit time, which runs *before* miku_encode_init() gets a
+    // chance to mutate codec_id to AV_CODEC_ID_MIKU_DELTA for delta mode.
+    // There's no earlier hook available to change that ordering, so
+    // pkt->flags can't reliably carry this information for this encoder;
+    // side data isn't touched by that mechanism, so it does.
+    AV_PKT_DATA_MIKU_IS_DELTA,
+
     /**
      * The number of side data types.
      * This is not part of the public API/ABI in the sense that it may
