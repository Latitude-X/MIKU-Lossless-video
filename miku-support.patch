index 0133751d..ca9b54d2 100644
--- a/libavcodec/codec_id.h
+++ b/libavcodec/codec_id.h
@@ -327,6 +327,23 @@ enum AVCodecID {
     AV_CODEC_ID_ASTC,
     AV_CODEC_ID_RW2,
 
+    // ---- .miku fork-local additions ----
+    // Value chosen explicitly (not auto-assigned) so it survives `git pull`
+    // merges against upstream FFmpeg without renumbering. The video ID range
+    // is one unbroken sequential block with no other explicit numeric
+    // assignment in it, all the way up to AV_CODEC_ID_FIRST_AUDIO (0x10000),
+    // so a value near the top of that range stays clear of where upstream
+    // sequentially appends new IDs. AVCodecID has no documented "private
+    // use" block -- it's FFmpeg's own internal enum, not a wire format, so a
+    // fork-local unused value is the correct mechanism here.
+    //
+    // Reserve the top of the range downward for any future fork-local codec
+    // IDs so they stay grouped together.
+    AV_CODEC_ID_MIKU_DELTA = 0xFFFE, ///< .miku delta-frame video (-delta_frames, on by default in the miku encoder).
+                                      ///< A keyframe packet is a plain WebP image but a delta packet is a WebP
+                                      ///< image of a residual, so decoding requires ff_miku_delta_decoder,
+                                      ///< never the stock webp decoder.
+
     /* various PCM "codecs" */
     AV_CODEC_ID_FIRST_AUDIO = 0x10000,     ///< A dummy id pointing at the start of audio codecs
     AV_CODEC_ID_PCM_S16LE = 0x10000,
diff --git a/libavcodec/packet.h b/libavcodec/packet.h
index 00774a70..25f43389 100644
--- a/libavcodec/packet.h
+++ b/libavcodec/packet.h
@@ -383,6 +383,45 @@ enum AVPacketSideDataType {
      */
     AV_PKT_DATA_HEVC_CONF,
 
+    // ---- .miku fork-local additions ----
+    // Purely in-process signals between the miku encoder, muxer, demuxer and
+    // decoder, never serialized to disk as such, so (unlike
+    // AV_CODEC_ID_MIKU_DELTA) they don't need explicit, collision-resistant
+    // numeric values; plain sequential entries are safe.
+    //
+    // AV_PKT_DATA_MIKU_IS_DELTA: presence on a packet from the "miku"
+    // encoder means "this is a delta-chain frame, not a keyframe" -- see
+    // mikuenc.c and mikumux.c. An empty/1-byte payload means the delta is
+    // against the previous frame; an 8-byte payload (little-endian int64) is
+    // the frame number of a LONG-TERM REFERENCE keyframe the delta is
+    // against instead.
+    //
+    // Why this exists instead of AV_PKT_FLAG_KEY: verified directly against
+    // libavcodec/encode.c that AV_CODEC_ID_WEBP's codec descriptor has
+    // AV_CODEC_PROP_INTRA_ONLY set, which makes the generic encode pipeline
+    // force AV_PKT_FLAG_KEY onto every packet this encoder produces
+    // (avpkt->flags |= ec->intra_only_flag, applied *after* this encoder's
+    // own callback returns) -- decided from avctx->codec_id at
+    // ff_encode_preinit time, which runs *before* miku_encode_init() gets a
+    // chance to mutate codec_id to AV_CODEC_ID_MIKU_DELTA for delta mode.
+    // There's no earlier hook available to change that ordering, so
+    // pkt->flags can't reliably carry this information for this encoder;
+    // side data isn't touched by that mechanism, so it does.
+    AV_PKT_DATA_MIKU_IS_DELTA,
+
+    // AV_PKT_DATA_MIKU_REF_FRAME: demuxer -> decoder (and, for a stream
+    // copy, demuxer -> muxer). Attached to a delta packet whose reference is
+    // a long-term keyframe rather than the previous frame. Payload:
+    // little-endian int64 frame number of that keyframe in the SOURCE file,
+    // followed by the keyframe's own complete WebP bytes. This makes the
+    // packet self-contained, so the referenced keyframe may be anywhere in
+    // the file, before or after the frame using it. The number is only a
+    // hint: the decoder caches decoded references by the keyframe's bytes,
+    // and the muxer matches a stream-copied reference to the keyframe in its
+    // output by content, because source numbering means nothing once frames
+    // are dropped or reordered. See mikudec.c, mikudeltadec.c and mikumux.c.
+    AV_PKT_DATA_MIKU_REF_FRAME,
+
     /**
